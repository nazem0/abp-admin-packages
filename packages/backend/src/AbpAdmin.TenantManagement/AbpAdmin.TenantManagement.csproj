<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>AbpAdmin.TenantManagement</PackageId>
    <Description>ABP Admin tenants: create, rename, enable/disable and delete tenants, a runtime multi-tenancy switch, per-tenant databases, and host management of every tenant's users. Needs the Tenant Management and Identity modules.</Description>
    <RootNamespace>AbpAdmin</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.TenantManagement.Domain" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.Identity.Domain" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.Identity.Application.Contracts" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.SettingManagement.Domain" Version="$(AbpVersion)" />
    <ProjectReference Include="..\AbpAdmin.Core\AbpAdmin.Core.csproj" />
  </ItemGroup>

</Project>
