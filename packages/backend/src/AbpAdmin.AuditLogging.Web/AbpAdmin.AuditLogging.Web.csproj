<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <PackageId>AbpAdmin.AuditLogging.Web</PackageId>
    <Description>ABP Admin Razor Pages UI for audit logging: the request log with its statistics dashboard, request traces, entity changes and entity history. Pages: /AbpAdmin/AuditLogs and /AbpAdmin/EntityChanges.</Description>
    <RootNamespace>AbpAdmin.Web</RootNamespace>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="11.0.0" />
    <ProjectReference Include="..\AbpAdmin.Core.Web\AbpAdmin.Core.Web.csproj" />
    <ProjectReference Include="..\AbpAdmin.AuditLogging\AbpAdmin.AuditLogging.csproj" />
  </ItemGroup>

  <!-- Served by ABP's virtual file system at /abp-admin/... (no static web assets setup needed in the host). -->
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" />
    <Content Remove="wwwroot\**\*" />
  </ItemGroup>

</Project>
