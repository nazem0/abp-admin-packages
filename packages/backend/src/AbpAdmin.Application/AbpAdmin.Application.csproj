<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>AbpAdmin.Application</PackageId>
    <Description>All of ABP Admin in one reference: core, audit logging, identity, OpenIddict, background jobs, tenants and the entity explorer. Reference the AbpAdmin.* feature packages instead to pick only some.</Description>
    <RootNamespace>AbpAdmin</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AbpAdmin.Core\AbpAdmin.Core.csproj" />
    <ProjectReference Include="..\AbpAdmin.AuditLogging\AbpAdmin.AuditLogging.csproj" />
    <ProjectReference Include="..\AbpAdmin.Identity\AbpAdmin.Identity.csproj" />
    <ProjectReference Include="..\AbpAdmin.OpenIddict\AbpAdmin.OpenIddict.csproj" />
    <ProjectReference Include="..\AbpAdmin.BackgroundJobs\AbpAdmin.BackgroundJobs.csproj" />
    <ProjectReference Include="..\AbpAdmin.EventBus\AbpAdmin.EventBus.csproj" />
    <ProjectReference Include="..\AbpAdmin.TenantManagement\AbpAdmin.TenantManagement.csproj" />
    <ProjectReference Include="..\AbpAdmin.EntityExplorer\AbpAdmin.EntityExplorer.csproj" />
  </ItemGroup>

</Project>
