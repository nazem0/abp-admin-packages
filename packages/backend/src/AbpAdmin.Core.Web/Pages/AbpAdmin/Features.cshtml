@page
@inject IAuthorizationService Authorization
@inject IAuthorizationPolicyProvider Policies
@functions {
    // Not [Authorize(...)]: that throws "No policy found" in apps without Feature Management; this returns 403 there.
    public async Task<Microsoft.AspNetCore.Mvc.IActionResult> OnGetAsync() =>
        await Authorization.IsGrantedAnyAsync(Policies, "FeatureManagement.ManageHostFeatures") ? Page() : Forbid();
}
@{
    Layout = "_AbpAdminLayout";
    ViewData["Title"] = "AbpAdmin::Nav:Features";
}
@section styles { <link rel="stylesheet" href="/abp-admin/core/features.css" /> }
<div class="page narrow" id="abp-features"></div>
@section scripts { <script src="/abp-admin/core/features.js"></script> }
