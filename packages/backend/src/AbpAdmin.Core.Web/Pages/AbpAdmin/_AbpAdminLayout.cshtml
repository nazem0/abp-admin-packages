@using Microsoft.Extensions.Localization
@using AbpAdmin.Localization
@inject AbpAdminLayoutBuilder Builder
@inject IStringLocalizer<AbpAdminResource> L
@{
    // Pages set ViewData["Title"] to a localization key ("AbpAdmin::Nav:Users"); the layout translates it.
    var vm = await Builder.BuildAsync();
    var c = vm.Configuration;
    var culture = c.Localization.CurrentCulture;
    var user = c.CurrentUser;
    string T(string key, params object[] args) => L[key.StartsWith("AbpAdmin::") ? key["AbpAdmin::".Length..] : key, args];
    var title = ViewData["Title"] as string;
    var languages = c.Localization.Languages;
    var languageName = languages.FirstOrDefault(l => l.CultureName == culture.Name)?.DisplayName ?? culture.Name;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="@culture.Name" dir="@(culture.IsRightToLeft ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="abp-admin-csrf" content="@vm.AntiforgeryToken" />
    <title>@(title is null ? "ABP Admin" : $"{T(title)} · ABP Admin")</title>
    <script>
        // Theme before first paint: light unless the user picked dark or system.
        try { var t = localStorage.getItem('abp-admin.theme'); if (t !== 'system') document.documentElement.setAttribute('data-abp-admin-theme', t === 'dark' ? 'dark' : 'light'); } catch (e) { document.documentElement.setAttribute('data-abp-admin-theme', 'light'); }
    </script>
    <link rel="stylesheet" href="/abp-admin/core/abp-admin.css" />
    <link rel="stylesheet" href="/abp-admin/core/shell.css" />
    @await RenderSectionAsync("styles", required: false)
</head>
<body class="abp-admin">
    <div class="shell">
        <aside class="rail">
            <a class="brand" href="@AbpAdminWebOptions.Url("Overview")" aria-label="@T("AbpAdmin::Shell:Home")">
                <svg viewBox="0 0 32 32" aria-hidden="true">
                    <path d="M16 3 27 7.5v8c0 6.6-4.6 11.4-11 13.5C9.6 26.9 5 22.1 5 15.5v-8Z" />
                    <path d="m11 16 3.5 3.5L21.5 12" />
                </svg>
                <span>ABP<b>Admin</b></span>
            </a>

            <button class="find" type="button" data-abp-admin-palette aria-label="@T("AbpAdmin::Shell:SearchAria")">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                <span>@T("AbpAdmin::Shell:Search")</span><kbd>Ctrl K</kbd>
            </button>

            <nav aria-label="@T("AbpAdmin::Shell:MainNav")">
                @foreach (var g in vm.Groups)
                {
                    if (g.Name != "") { <span class="section">@T($"AbpAdmin::Nav:Section:{g.Name}")</span> }
                    foreach (var n in g.Items)
                    {
                        var parentActive = n.Active && !n.Children.Any(x => x.Active);
                        <a href="@n.Url" class="@(n.Active ? "active" : null)" aria-current="@(parentActive ? "page" : null)" title="@T(n.Item.LabelKey)">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="@n.Item.Icon" /></svg>
                            <span>@T(n.Item.LabelKey)</span>
                        </a>
                        if (n.Children.Count > 0)
                        {
                            <div class="sub">
                                @foreach (var s in n.Children)
                                {
                                    <a href="@s.Url" class="@(s.Active ? "active" : null)" aria-current="@(s.Active ? "page" : null)" title="@T(s.Item.LabelKey)"><span>@T(s.Item.LabelKey)</span></a>
                                }
                            </div>
                        }
                    }
                }
            </nav>

            <div class="me">
                @if (languages.Count > 1)
                {
                    <button class="icon-btn" type="button" popovertarget="lang-menu" title="@T("AbpAdmin::Shell:LanguageTitle", languageName)" aria-label="@T("AbpAdmin::Shell:LanguageAria", languageName)">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></svg>
                    </button>
                    <div id="lang-menu" class="lang-menu" popover role="menu" aria-label="@T("AbpAdmin::Shell:Language")">
                        @foreach (var l in languages)
                        {
                            var on = l.CultureName == culture.Name;
                            <a role="menuitemradio" aria-checked="@(on ? "true" : "false")" class="@(on ? "on" : null)"
                               href="/Abp/Languages/Switch?culture=@Uri.EscapeDataString(l.CultureName)&uiCulture=@Uri.EscapeDataString(l.UiCultureName)&returnUrl=@Uri.EscapeDataString(returnUrl)">
                                <span>@l.DisplayName</span><small>@l.CultureName</small>
                            </a>
                        }
                    </div>
                }
                <button class="icon-btn" type="button" data-abp-admin-theme-toggle></button>
                <span class="avatar" aria-hidden="true">@((user.UserName ?? "?")[..1].ToUpperInvariant())</span>
                <span class="who"><b>@user.UserName</b><small>@user.Email</small></span>
                <a class="icon-btn" href="/Account/Logout" title="@T("AbpAdmin::Shell:SignOut")" aria-label="@T("AbpAdmin::Shell:SignOut")">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4h4v16h-4M10 8l-4 4 4 4M6 12h10" /></svg>
                </a>
            </div>
        </aside>
        <main>@RenderBody()</main>
    </div>

    <dialog id="abp-admin-palette" class="palette" aria-label="@T("AbpAdmin::Palette:Title")">
        <div class="box">
            <label class="q">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                <input type="text" placeholder="@T("AbpAdmin::Palette:Placeholder")" aria-label="@T("AbpAdmin::Palette:SearchAria")" autocomplete="off" role="combobox" aria-controls="cp-list" />
                <kbd>Esc</kbd>
            </label>
            <ul id="cp-list" role="listbox"></ul>
            <footer><span><kbd>↑</kbd><kbd>↓</kbd> @T("AbpAdmin::Palette:Move")</span><span><kbd>Enter</kbd> @T("AbpAdmin::Palette:Open")</span></footer>
        </div>
    </dialog>
    <div id="abp-admin-toasts" class="toasts" role="status" aria-live="polite"></div>

    <script>window.abpAdminConfig = @Html.Raw(vm.ConfigJson);</script>
    <script src="/abp-admin/core/abp-admin.js"></script>
    @await RenderSectionAsync("scripts", required: false)
</body>
</html>
