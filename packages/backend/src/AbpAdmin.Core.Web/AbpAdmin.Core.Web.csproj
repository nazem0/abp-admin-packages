<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <PackageId>AbpAdmin.Core.Web</PackageId>
    <Description>ABP Admin Razor Pages UI core: the console layout (sidebar, Ctrl+K palette, toasts, theme, language menu), the overview, settings and features pages, and the shared browser runtime. Pages live under /AbpAdmin.</Description>
    <RootNamespace>AbpAdmin.Web</RootNamespace>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="$(MicrosoftPackagesVersion)" />
    <ProjectReference Include="..\AbpAdmin.Core\AbpAdmin.Core.csproj" />
  </ItemGroup>

  <!-- Served by ABP's virtual file system at /abp-admin/... (no static web assets setup needed in the host). -->
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" />
    <Content Remove="wwwroot\**\*" />
  </ItemGroup>

</Project>
