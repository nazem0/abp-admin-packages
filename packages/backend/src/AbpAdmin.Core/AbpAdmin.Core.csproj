<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>AbpAdmin.Core</PackageId>
    <Description>ABP Admin core: the AbpAdmin permission group, localization (en, ar), host-support checks, the overview dashboard and the conventions every ABP Admin feature package builds on.</Description>
    <RootNamespace>AbpAdmin</RootNamespace>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="$(MicrosoftPackagesVersion)" />
    <PackageReference Include="Volo.Abp.Ddd.Application" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.Mapperly" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc" Version="$(AbpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\AbpAdmin\*.json" />
    <Content Remove="Localization\AbpAdmin\*.json" />
  </ItemGroup>

</Project>
