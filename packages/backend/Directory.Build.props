<Project>
  <PropertyGroup>
    <!-- One package per ABP major: each ABP major ships for one .NET (ABP 10 = net10.0, ABP 11 = net11.0), so NuGet
         gives an app the build that matches its ABP version. -->
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <NuGetAudit>false</NuGetAudit>
    <AbpVersion>11.0.0</AbpVersion>
    <MicrosoftPackagesVersion>11.0.0</MicrosoftPackagesVersion>
    <LeptonXLiteVersion>6.0.0</LeptonXLiteVersion>

    <!-- NuGet package metadata -->
    <Version>0.4.3</Version>
    <Authors>ABP Admin contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/nazem0/abp-admin-packages</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/nazem0/abp-admin-packages</PackageProjectUrl>
    <PackageTags>abp;abp-framework;admin;audit-log;openiddict;identity</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts</PackageOutputPath>

    <!-- Debuggable, verifiable packages (nuget.org "Health"): the PDB is embedded in each DLL, so it carries the symbols,
         Source Link (the SDK adds it for GitHub repos) and the compiler flags without a separate .snupkg. -->
    <DebugType>embedded</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Deterministic paths (/_/...) for published builds only; local builds keep real paths for debugging. -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Packages compile against the FIRST release of each ABP major: dependency versions in a package are minimums, so
       every ABP 10.x / 11.x app can install them (NuGet keeps the app's newer ABP). Pinning the latest ABP 10 minor here
       made 10.7.1 the minimum and broke apps on 10.0 - 10.6 (NU1605).
       The sample host and the tests use the newest release instead (*HostVersion): they show the packages also run there,
       and dev-only dependencies such as the ABP Studio client need it. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <AbpVersion>10.0.0</AbpVersion>
    <MicrosoftPackagesVersion>10.0.0</MicrosoftPackagesVersion>
    <AbpHostVersion>10.7.1</AbpHostVersion>
    <MicrosoftHostVersion>10.0.15</MicrosoftHostVersion>
    <LeptonXLiteVersion>5.7.1</LeptonXLiteVersion>
  </PropertyGroup>
  <PropertyGroup>
    <AbpHostVersion Condition="'$(AbpHostVersion)' == ''">$(AbpVersion)</AbpHostVersion>
    <MicrosoftHostVersion Condition="'$(MicrosoftHostVersion)' == ''">$(MicrosoftPackagesVersion)</MicrosoftHostVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
