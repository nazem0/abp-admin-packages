{
  "App": {
    "SelfUrl": "https://localhost:44366",
    "ClientUrl": "http://localhost:4200",
    "CorsOrigins": "https://*.Abp_Administration.com,http://localhost:4200",
    "RedirectAllowedUrls": "http://localhost:4200",
    "HealthCheckUrl": "/health-status"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Server=(LocalDb)\\MSSQLLocalDB;Database=Abp_Administration;Trusted_Connection=True;TrustServerCertificate=true"
  },
  "AuthServer": {
    "Authority": "https://localhost:44366",
    "SwaggerClientId": "Abp_Administration_Swagger",
    "CertificatePassPhrase": "cfa78763-54e8-47a4-9c2d-9a8a002aa5d5"
  },
  "Settings": {
    "Abp.Identity.Password.RequireNonAlphanumeric": "false",
    "Abp.Identity.Password.RequireLowercase": "false",
    "Abp.Identity.Password.RequireUppercase": "false",
    "Abp.Identity.Password.RequireDigit": "false"
  },
  "StringEncryption": {
    "DefaultPassPhrase": "9tcrXBuYOvdcVcoZ"
  },
  "OpenIddict": {
    "Applications": {
      "Abp_Administration_App": {
        "ClientId": "Abp_Administration_App",
        "RootUrl": "http://localhost:4200"
      },
      "Abp_Administration_Swagger": {
        "ClientId": "Abp_Administration_Swagger",
        "RootUrl": "https://localhost:44366"
      }
    }
  }
}
